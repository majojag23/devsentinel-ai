# Copy to .env.local. Never commit credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3100

# Google Cloud Console / OAuth 2.0 Web application
# Redirect URI: http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub Settings / Developer settings / OAuth Apps
# Callback URL: http://localhost:3100/api/auth/callback/github
# Public repositories only. Private repos require the planned GitHub App.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Production behind the PHP reverse proxy
AUTH_TRUST_HOST=true
PORT=3100

# AI agent. Free for testing: gemini (https://aistudio.google.com/apikey) | groq | openrouter. Paid later: anthropic.
# Any OpenAI-compatible endpoint also works: AI_PROVIDER=custom + AI_BASE_URL + AI_MODEL.
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL=
